{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/.prisma/client/**",
        "node_modules/@prisma/client/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}



DIRECT_URL="postgresql://user:password@localhost:5432/HRMs"
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_EMAIL="your-email@example.com"
